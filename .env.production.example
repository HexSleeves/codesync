# CodeSync Production Environment
# Copy to .env.production and fill in real values
# NEVER commit this file with real secrets!

# ===================
# Required - MUST CHANGE
# ===================

# Database (use a secure password)
DATABASE_URL=postgres://codesync:SECURE_PASSWORD@localhost:5432/codesync

# Auth secrets (generate with: openssl rand -base64 32)
JWT_SECRET=GENERATE_ME
PASSWORD_SALT=GENERATE_ME

# ===================
# GitHub OAuth
# ===================
# Production OAuth app: https://github.com/settings/developers

GITHUB_CLIENT_ID=your-production-client-id
GITHUB_CLIENT_SECRET=your-production-client-secret
GITHUB_REDIRECT_URI=https://your-domain.com/api/github/callback

# ===================
# URLs (update for your domain)
# ===================

FRONTEND_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com

# ===================
# Server
# ===================

PORT=8001
NODE_ENV=production
