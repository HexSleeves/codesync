[Unit]
Description=CodeSync Client (Vite Preview)
After=network.target codesync-api.service
Wants=codesync-api.service

[Service]
Type=simple
User=exedev
Group=exedev
WorkingDirectory=/home/exedev/codesync/packages/client
ExecStart=/home/exedev/.bun/bin/bun run preview --host 0.0.0.0 --port 5173
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=codesync-client

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/exedev/codesync

[Install]
WantedBy=multi-user.target
