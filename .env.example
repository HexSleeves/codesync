# CodeSync Environment Variables
# Copy to .env and fill in your values

# ===================
# Required
# ===================

# Database connection string
DATABASE_URL=postgres://codesync:codesync@localhost:5432/codesync

# JWT secret for auth tokens (generate with: openssl rand -base64 32)
JWT_SECRET=change-me-in-production

# Password hashing salt (generate with: openssl rand -base64 16)
PASSWORD_SALT=change-me-in-production

# ===================
# GitHub OAuth (optional)
# ===================
# Create app at: https://github.com/settings/developers

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8001/api/github/callback

# ===================
# URLs & CORS
# ===================

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# CORS allowed origin
CORS_ORIGIN=http://localhost:5173

# ===================
# Optional
# ===================

# API server port (default: 8001)
PORT=8001

# Environment: development | production
NODE_ENV=development
