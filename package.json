{
  "name": "codesync",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:api": "bun run --filter @codesync/api dev",
    "dev:client": "bun run --filter @codesync/client dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "db:migrate": "bun run --filter @codesync/api db:migrate",
    "db:studio": "bun run --filter @codesync/api db:studio",
    "db:seed": "bun run --filter @codesync/api db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "typescript": "^5.9.3"
  }
}
