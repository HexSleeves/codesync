[Unit]
Description=CodeSync - Real-time Code Review Application
After=network.target

[Service]
Type=simple
User=exedev
WorkingDirectory=/home/exedev/codesync
Environment=METEOR_SETTINGS={}
Environment=PORT=8000
Environment=ROOT_URL=http://localhost:8000
ExecStart=/home/exedev/.meteor/meteor --port 8000
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
